# Copy to `.env` and fill in as needed. `.env` is git-ignored — never commit keys.
# All values are optional: with none set, the engine runs in token-free mock mode
# and local providers (LM Studio / Ollama) need no key.

# --- Model providers (set only the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Local Ollama server (defaults to http://localhost:11434 if unset):
OLLAMA_BASE_URL=

# --- Web search tool (optional; falls back to DuckDuckGo if unset) ---
TAVILY_API_KEY=

# --- HTTP API defaults (only relevant when running `app.api`) ---
DS_PLANNER=mock
DS_PROVIDER=openai
DS_MODEL=gpt-5.4-nano
# DS_API_KEY=            # if set, guards POST endpoints

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=Dynamic Subgraphs
